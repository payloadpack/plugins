{
  "name": "payloadpack-plugins",
  "private": true,
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "turbo build",
    "dev:theme": "turbo dev --filter=@apps/theme-demo",
    "dev:path": "turbo dev --filter=@apps/path-demo",
    "dev:path:localized": "turbo dev:localized --filter=@apps/path-demo",
    "dev:docs": "turbo dev --filter=@apps/docs",
    "generate": "turbo generate:importmap generate:types",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "typecheck": "turbo typecheck",
    "doctor": "react-doctor -y",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "react-doctor": "^0.9.18",
    "turbo": "^2.6.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "@embedded-postgres/darwin-arm64",
    "@embedded-postgres/darwin-x64",
    "@embedded-postgres/linux-arm",
    "@embedded-postgres/linux-arm64",
    "@embedded-postgres/linux-ia32",
    "@embedded-postgres/linux-ppc64",
    "@embedded-postgres/linux-x64",
    "@embedded-postgres/windows-x64"
  ]
}
