{
  "name": "payloadpack-plugins",
  "private": true,
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --filter=@apps/theme-demo",
    "generate": "turbo generate:importmap generate:types --filter=@apps/theme-demo",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "typecheck": "turbo typecheck",
    "check:duplicates": "./scripts/check-duplicates.sh",
    "doctor": "react-doctor -y",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "react-doctor": "^0.9.18",
    "turbo": "^2.6.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
