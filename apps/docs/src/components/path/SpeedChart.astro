---
import SpeedBars, { type Panel } from './SpeedBars.astro'
import { DATABASE_LABELS, formatTiming, METHODS, methodLabel, report, unlocalizedSetups } from './speed'

interface Props {
  kind: 'lookups' | 'moves'
}

const { kind } = Astro.props

type Point = { median: number; method: string; p95: number; runs?: number; x: number }

const pointsOf = ({ lookups, moves }: (typeof unlocalizedSetups)[number]): Point[] =>
  kind === 'lookups'
    ? lookups.map(({ depth, method, median, p95 }) => ({ median, method, p95, x: depth }))
    : moves.map(({ below, method, median, p95, runs }) => ({ median, method, p95, runs, x: below }))

const xLabel = (x: number) =>
  kind === 'lookups' ? `${x} ${x === 1 ? 'segment' : 'segments'}` : `${x.toLocaleString('en')} pages below`

const setups = unlocalizedSetups.map((setup) => ({ database: setup.database, points: pointsOf(setup) }))
const xValues = [...new Set(setups.flatMap(({ points }) => points.map(({ x }) => x)))].sort((first, second) => first - second)
const methods = METHODS.filter((method) => setups.some(({ points }) => points.some((point) => point.method === method)))

// One panel per database, and in it one group of bars per page the benchmark looked up or moved.
const panels: Panel[] = setups.map(({ database, points }) => ({
  groups: xValues.map((x) => ({
    bars: methods.flatMap((method) => {
      const point = points.find((each) => each.x === x && each.method === method)
      return point
        ? [
            {
              label: methodLabel(method),
              median: point.median,
              title: `${methodLabel(method)}, ${xLabel(x)}: ${formatTiming(point)}${point.runs ? `, ${point.runs} runs` : ''}`
            }
          ]
        : []
    }),
    label: xLabel(x)
  })),
  title: DATABASE_LABELS[database]
}))

const { documents, lookupRuns } = report.ranOn
const caption =
  kind === 'lookups'
    ? `The database on the same machine, ${documents.toLocaleString('en')} documents. The median of ${lookupRuns.toLocaleString('en')} lookups. Shorter is better.`
    : `The database on the same machine, ${documents.toLocaleString('en')} documents. The median of the renames of each page. Shorter is better.`
---

<SpeedBars caption={caption} panels={panels}>
  <table>
    <thead>
      <tr>
        <th>Method</th>
        <th>{kind === 'lookups' ? 'Segments' : 'Pages below'}</th>
        {setups.map(({ database }) => <th>{DATABASE_LABELS[database]}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        methods.flatMap((method) =>
          xValues.map((x) => (
            <tr>
              <td>{methodLabel(method)}</td>
              <td>{x.toLocaleString('en')}</td>
              {setups.map(({ points }) => {
                const point = points.find((each) => each.x === x && each.method === method)
                return <td>{point ? formatTiming(point) : '-'}</td>
              })}
            </tr>
          ))
        )
      }
    </tbody>
  </table>
</SpeedBars>
