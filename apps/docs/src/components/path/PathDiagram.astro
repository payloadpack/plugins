---
interface Props {
  // A caption below the picture.
  caption?: string
  // Stack the pictures, as a before and after, or set them side by side.
  layout?: 'columns' | 'stack'
}

const { caption, layout = 'stack' } = Astro.props
---

<figure>
  <div class:list={['path-diagram-body', 'not-content', `path-diagram-${layout}`]}>
    <slot />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .path-diagram-body {
    display: flex;
    gap: 0.75rem;
    padding: 1.125rem;
    border: 1px solid var(--docs-border);
    border-radius: 0.75rem;
    background: var(--docs-card);
    overflow-x: auto;
  }

  .path-diagram-stack {
    flex-direction: column;
  }

  .path-diagram-columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.25rem;
  }

  figcaption {
    margin-block-start: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--docs-muted-foreground);
  }
</style>
