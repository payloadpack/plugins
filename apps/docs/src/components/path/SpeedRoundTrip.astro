---
import { DATABASE_LABELS, formatTime, roundTripRun } from './speed'

interface Props {
  kind: 'link-queries' | 'lookups' | 'menu'
}

const { kind } = Astro.props

const { databases, methods, ranOn, roundTrips } = roundTripRun
const methodLabel = (method: string) => methods.find(({ id }) => id === method)!.label
const formatQueries = (queries: number) => queries.toLocaleString('en')

// One table per database. A row of times has one at each round trip, and its query count is the same at each.
const tables = databases.map(({ database, linkQueries, lookups, menu }) => {
  const linkMethods = [...new Set(linkQueries.map(({ method }) => method))]
  const queriesOf = (name: string, method: string) =>
    linkQueries.find((link) => link.name === name && link.method === method)!.queries
  return {
    database,
    linkMethods,
    linkQueries: [...new Set(linkQueries.map(({ name }) => name))].map((name) => ({
      name,
      queries: linkMethods.map((method) => queriesOf(name, method))
    })),
    times:
      kind === 'lookups'
        ? lookups.map(({ depth, medians, method, queries }) => ({
            label: `${methodLabel(method)}, ${depth} ${depth === 1 ? 'segment' : 'segments'}`,
            medians,
            queries
          }))
        : menu.rows.map(({ medians, method }) => ({
            label: methodLabel(method),
            medians,
            queries: queriesOf(menu.name, method)
          })),
    timesOf: kind === 'lookups' ? 'A lookup' : menu.name
  }
})
---

{
  kind === 'lookups' && (
    <p>
      Measured on {ranOn.date}, with {ranOn.pagesPerCollection.toLocaleString('en')} pages per collection. A proxy between the
      site and the database holds each query back by the round trip. Each time is the median of {ranOn.lookupRuns} lookups or{' '}
      {ranOn.menuRuns} reads of a menu, {ranOn.linkByLinkRuns} for link by link.
    </p>
  )
}
{
  tables.map(({ database, linkMethods, linkQueries, times, timesOf }) => (
    <table>
      <caption>{DATABASE_LABELS[database]}</caption>
      {kind === 'link-queries' ? (
        <>
          <thead>
            <tr>
              <th>Queries</th>
              {linkMethods.map((method) => (
                <th>{methodLabel(method)}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {linkQueries.map(({ name, queries }) => (
              <tr>
                <td>{name}</td>
                {queries.map((count) => (
                  <td>{formatQueries(count)}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </>
      ) : (
        <>
          <thead>
            <tr>
              <th>{timesOf}</th>
              <th>Queries</th>
              {roundTrips.map((roundTrip) => (
                <th>{roundTrip === 0 ? 'Same machine' : `${roundTrip} ms added per query`}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {times.map(({ label, medians, queries }) => (
              <tr>
                <td>{label}</td>
                <td>{formatQueries(queries)}</td>
                {medians.map((median) => (
                  <td>{formatTime(median)}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </>
      )}
    </table>
  ))
}

<style>
  caption {
    caption-side: top;
    text-align: start;
    font-weight: 600;
    color: var(--docs-foreground);
    padding-block-end: 0.5rem;
  }
</style>
