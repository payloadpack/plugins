---
// Shows a Payload sidebar field and the exact refusal message displayed beneath it.
interface Props {
  field: string
  heading?: string
  message: string
  value: string
}

const { field, heading, message, value } = Astro.props
---

<div class="refusal-box not-content">
  {heading && <p class="refusal-box-heading">{heading}</p>}
  <div class="refusal-box-field">
    <span class="refusal-box-label">{field}</span>
    <span class="refusal-box-input">{value}</span>
    <p class="refusal-box-message">{message}</p>
  </div>
</div>

<style>
  .refusal-box {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }

  .refusal-box-heading {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--docs-muted-foreground);
  }

  .refusal-box-field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .refusal-box-label {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--docs-foreground);
  }

  .refusal-box-input {
    padding: 0.4375rem 0.625rem;
    border: 1px solid var(--docs-danger-border);
    border-radius: 0.5rem;
    background: var(--sl-color-bg);
    font-family: var(--sl-font-mono);
    font-size: 0.8125rem;
    color: var(--docs-foreground);
  }

  .refusal-box-message {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--docs-danger);
  }
</style>
