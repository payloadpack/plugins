{
  "name": "@apps/redirects-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "node scripts/with-database.ts next dev --port ${DEMO_PORT:-3040}",
    "generate": "bun run generate:importmap && bun run generate:types",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "start": "node scripts/with-database.ts next start --port ${DEMO_PORT:-3040}",
    "test:e2e": "playwright test",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "4.0.0-beta.11",
    "@payloadcms/next": "4.0.0-beta.11",
    "@payloadcms/ui": "4.0.0-beta.11",
    "@payloadpack/path": "workspace:*",
    "@payloadpack/redirects": "workspace:*",
    "next": "16.4.6",
    "payload": "4.0.0-beta.11",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "mongodb-memory-server": "11.3.0",
    "typescript": "6.0.3"
  }
}
