{
  "name": "@payloadpack/path",
  "version": "0.1.0",
  "description": "Stored URL paths for Payload 4 pages and posts. Editors pick a parent and a slug, and a site finds the document at a path in one indexed query, in any language.",
  "keywords": [
    "payload",
    "payloadcms",
    "payload-plugin",
    "path",
    "url",
    "slug",
    "nested-pages",
    "localization",
    "mongodb",
    "postgres",
    "sqlite"
  ],
  "homepage": "https://docs.payloadpack.com/path/",
  "bugs": {
    "url": "https://github.com/payloadpack/plugins/issues"
  },
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/payloadpack/plugins.git",
    "directory": "packages/path"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "bench": "vitest run --config bench/vitest.config.ts",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@payloadcms/ui": "^4.0.0-beta.10",
    "payload": "^4.0.0-beta.10",
    "react": "^19"
  },
  "devDependencies": {
    "@payloadcms/db-mongodb": "4.0.0-beta.10",
    "@payloadcms/db-postgres": "4.0.0-beta.10",
    "@payloadcms/db-sqlite": "4.0.0-beta.10",
    "@payloadcms/plugin-nested-docs": "4.0.0-beta.10",
    "@payloadcms/richtext-lexical": "4.0.0-beta.10",
    "@payloadcms/ui": "4.0.0-beta.10",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "embedded-postgres": "18.6.0-beta.19",
    "mongodb-memory-server": "11.3.0",
    "payload": "4.0.0-beta.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rimraf": "6.1.2",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": "^24.22.3 || >=26.13.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
