{
  "name": "@payloadpack/redirects",
  "version": "0.1.2",
  "description": "Redirects editors manage in Payload 4, found through database indexes at the same cost for any number of them. Every page move a site reports, from its own hook or through @payloadpack/path, suggests a redirect from its old path, which an editor turns on with a yes.",
  "keywords": [
    "payload",
    "payloadcms",
    "payload-plugin",
    "redirects",
    "301",
    "308",
    "regex",
    "re2",
    "seo",
    "mongodb",
    "postgres",
    "sqlite"
  ],
  "homepage": "https://docs.payloadpack.com/redirects/",
  "bugs": {
    "url": "https://github.com/payloadpack/plugins/issues"
  },
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/payloadpack/plugins.git",
    "directory": "packages/redirects"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rimraf dist && bun run build:types && bun run build:swc",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths --ignore \"**/*.d.ts\"",
    "build:types": "tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "re2js": "2.10.0"
  },
  "peerDependencies": {
    "@payloadcms/ui": "^4.0.0-beta.12",
    "payload": "^4.0.0-beta.12",
    "react": "^19"
  },
  "devDependencies": {
    "@payloadcms/db-mongodb": "4.0.0-beta.12",
    "@payloadcms/db-postgres": "4.0.0-beta.12",
    "@payloadcms/db-sqlite": "4.0.0-beta.12",
    "@payloadcms/ui": "4.0.0-beta.12",
    "@payloadpack/path": "workspace:*",
    "@swc/cli": "0.7.9",
    "@swc/core": "^1.10.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "embedded-postgres": "18.6.0-beta.19",
    "mongodb-memory-server": "11.3.0",
    "payload": "4.0.0-beta.12",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rimraf": "6.1.2",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": "^24.22.3 || >=26.13.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
